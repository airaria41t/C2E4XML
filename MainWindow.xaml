<Window x:Class="C2E4XML.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:C2E4XML"
        mc:Ignorable="d"
        Title="Convert" Icon="/とけちゃう猫さん.png"
        Height="250" Width="550" 
        ResizeMode="CanMinimize" WindowStyle="SingleBorderWindow" Loaded="MainWindow_Loaded">
    <Window.Resources>
        <local:BoolToColorConverter x:Key="BoolToColorConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 上部 -->
            <RowDefinition Height="*"/>
            <!-- 中央 -->
            <RowDefinition Height="Auto"/>
            <!-- 下部 -->
        </Grid.RowDefinitions>

        <!--ファイルパス設定-->
        <!--テキストボックス・ボタン並び整理-->
        <StackPanel Grid.Row="0"
                    Orientation="Vertical"
                    VerticalAlignment="Top" HorizontalAlignment="Center"
                    Margin="0,15" Height="75" 
                    Background="{DynamicResource ControlFillColorDefaultBrush}">
            <TextBox Text="ファイルパス" FontSize="15"
                     Width="130" BorderThickness="0" Background="Transparent" 
                     VerticalAlignment="Top" HorizontalAlignment="Left"
                     IsReadOnly="True" IsHitTestVisible="False" />
            <StackPanel Orientation="Horizontal"
                        Height="40"
                        VerticalAlignment="Top" HorizontalAlignment="Center">
                <!--パス入力欄-->
                <TextBox x:Name="txtFilePath" Text="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" FontSize="16"
                         VerticalContentAlignment="Top"
                         VerticalAlignment="Top"
                         Height="30" Width="420" Margin="5,0,0,0" 
                         AllowDrop="True"
                         PreviewDragOver="TxtFilePath_PreviewDragOver" 
                         PreviewDrop="TxtFilePath_PreviewDrop" />
                <!--オープンファイルダイアログ表示-->
                <Button x:Name="btnFilePath" Content="&#xE8A5;" FontSize="18"
                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                        HorizontalContentAlignment="Left"
                        Style="{DynamicResource AccentButtonStyle}" 
                        Cursor="Hand" 
                        Height="33" Width="40" Margin="5,0,5,0"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        ToolTip="ファイル設定"
                        Click="BtnFilePath_Click"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal" 
                    VerticalAlignment="Top"
                    Height="50" Margin="0">
            
            <!--トグル-->
            <TextBlock Text="詳細" FontSize="15"
                       VerticalAlignment="Center"
                       Margin="100,0,0,0" />
            <ToggleButton x:Name="tglDetailOut" 
                          Width="40" Height="20" Margin="3,0,0,0" 
                          HorizontalAlignment="Left" VerticalAlignment="Center" 
                          IsChecked="True" >
                <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="SwitchBorder" CornerRadius="11" Background="LightGray"/>
                            <Ellipse x:Name="Knob" Width="16" Height="16" Margin="2" Fill="White" 
                                     HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchBorder" Property="Background"
                                        Value="{x:Static SystemColors.HighlightBrush}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </ToggleButton.Template>
            </ToggleButton>

            <!--変換ボタン-->
            <Button x:Name="btnConvert" Content="&#xEE4A;"
                    FontSize="20" FontFamily="{StaticResource SymbolThemeFontFamily}" 
                    VerticalContentAlignment="Top"
                    Cursor="Hand" 
                    Style="{DynamicResource AccentButtonStyle}" 
                    Height="32" Width="100" Margin="200,0,0,0" 
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    ToolTip="変換"
                    Click="BtnConvert_Click" />
            <TextBox x:Name="txtResultMarkB" Text="✔" FontSize="15"
                     HorizontalContentAlignment="Right"
                     Width="20" Height="20" Margin="0,10,0,0" Padding="0"
                     VerticalAlignment="Center"
                     BorderThickness="0" Background="Transparent" Foreground="SeaGreen"
                     IsReadOnly="True" IsHitTestVisible="False" />
        </StackPanel>

        <!--結果-->
        <!--進捗ステータス-->
        <StackPanel Grid.Row="2"
                    x:Name="stkProgressBar"
                    Orientation="Vertical"
                    Height="30" Margin="0"
                    VerticalAlignment="Bottom" 
                    Visibility="Visible" >
            <StackPanel Orientation="Horizontal" Height="25">
                <TextBox x:Name="txtResultMark" Text="✔" 
                         FontSize="12"
                         HorizontalContentAlignment="Right" VerticalContentAlignment="Center"
                         Width="20" Height="25" Padding="0"
                         BorderThickness="0" 
                         Background="Transparent" 
                         Foreground="SeaGreen"
                         IsReadOnly="True" IsHitTestVisible="False" />
                <TextBox x:Name="txtStatus" Text="あああtest..."
                         FontSize="10"
                         VerticalContentAlignment="Center"
                         Width="150" Height="25" Padding="0,4,0,0"
                         BorderThickness="0"
                         Background="Transparent" 
                         IsReadOnly="True" IsHitTestVisible="False" />
                <TextBox x:Name="txtResult" Text="{Binding LastResultMessage}"
                         FontSize="10"
                         VerticalContentAlignment="Center" HorizontalContentAlignment="Right"
                         Width="320" Height="25" Padding="0,4,0,0" 
                         IsReadOnly="True" IsHitTestVisible="False" 
                         BorderThickness="0" 
                         Background="Transparent" 
                         HorizontalAlignment="Right" />

                <!--エクスプローラ表示-->
                <Button x:Name="btnExplorer" Content="&#xE8A1;" 
                        FontSize="13" FontFamily="{StaticResource SymbolThemeFontFamily}" 
                        VerticalContentAlignment="Top"
                        Cursor="Hand"
                        Style="{DynamicResource AccentButtonStyle}"
                        Width="40" Height="25" 
                        VerticalAlignment="Bottom" HorizontalAlignment="Right"
                        ToolTip="Excel起動"
                        Click="BtnExplorer_Click"/>
            </StackPanel>
            <!--変換進捗バー-->
            <ProgressBar x:Name="prgConvert" 
                         Height="5" 
                         VerticalAlignment="Bottom"
                         Minimum="0" Maximum="100" Value="{Binding ProgressValue}"/>
        </StackPanel>
    </Grid>
</Window>
